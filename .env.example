# Copy this file to .env and fill in your own values.
# Never commit the real .env file or share your actual API key.

# --- Database ---
DATABASE_URL=postgresql+psycopg://logisense:logisense@localhost:5432/logisense

# --- Groq (LLM: hypothesis generation, validation, mitigation, analysis) ---
# Get a key at https://console.groq.com -- put YOUR OWN key here, never one
# that has been shared with you in chat or logs.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=45
GROQ_RETRY_MAX_ATTEMPTS=5

# --- Optional external evidence connector ---
# Free key at https://aisstream.io -- if left unset, that connector marks
# itself unavailable rather than crashing or fabricating data.
AISSTREAM_API_KEY=

# --- RAG / embeddings (local model, no key needed) ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
CHROMA_PERSIST_DIR=.chroma_data
CHROMA_COLLECTION_NAME=logisense_documents
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.25

# --- Hybrid (dense + BM25) retrieval ---
RETRIEVAL_MODE=hybrid
DENSE_TOP_K=20
BM25_TOP_K=20
HYBRID_TOP_K=5
RRF_K=60
BM25_INDEX_PATH=.chroma_data/bm25_index.pkl

APP_ENV=local
LOG_LEVEL=INFO
