# Local working defaults for this project. GROQ_API_KEY is a placeholder --
# paste your own real key here before running anything that calls the LLM
# (generate-hypotheses, validate-hypotheses, generate-mitigations, analyze).
# Never commit this file or share your real key.

# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:trade@localhost:5432/logisense

# --- Groq (LLM: hypothesis generation, validation, mitigation, analysis) ---
GROQ_API_KEY=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
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=45
GROQ_RETRY_MAX_ATTEMPTS=5

# --- Optional external evidence connector ---
AISSTREAM_API_KEY=8c9f9139d04bc973a02e22c0a6a3fa4b995f3de6


# --- RAG / embeddings (local model, no key needed) ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
CHROMA_PERSIST_DIR=.chroma_data
CHROMA_COLLECTION_NAME=logisense_documents
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.25

# --- Hybrid (dense + BM25) retrieval ---
RETRIEVAL_MODE=hybrid
DENSE_TOP_K=20
BM25_TOP_K=20
HYBRID_TOP_K=5
RRF_K=60
BM25_INDEX_PATH=.chroma_data/bm25_index.pkl

APP_ENV=local
LOG_LEVEL=INFO
